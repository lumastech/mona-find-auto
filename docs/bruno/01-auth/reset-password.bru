meta {
  name: Reset password
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "phone": "0977123456",
    "code": "000000",
    "password": "a-brand-new-password",
    "password_confirmation": "a-brand-new-password"
  }
}

docs {
  Revokes **every** session and API token, including the one in this
  collection's environment. Somebody resetting a password may be doing it
  because the old one is known to somebody else. Log in again afterwards.
}
