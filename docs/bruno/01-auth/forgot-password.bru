meta {
  name: Forgot password
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "phone": "0977123456"
  }
}

docs {
  Answers **identically** whether or not the number belongs to an account. An
  endpoint that answered differently would be a way to test who has a MonaFind
  account, one guessable number at a time.
}
