meta {
  name: Change password
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/profile/password
  body: json
}

body:json {
  {
    "current_password": "a-long-enough-password",
    "password": "an-even-longer-password",
    "password_confirmation": "an-even-longer-password"
  }
}

docs {
  Ends every **other** session and token. This one keeps working — signing
  somebody out of the app at the moment they successfully changed their
  password reads as a failure.
}
