###############################################################################
# MonaFindAuto — environment template
#
# Copy to .env and fill in. Values below are the Docker Compose dev defaults;
# every host name matches a service in compose.yaml.
###############################################################################

APP_NAME=MonaFindAuto
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Datetimes are STORED in UTC. Africa/Lusaka is applied at render time only
# (see MONAFIND_DISPLAY_TIMEZONE below) so money and audit trails stay portable.
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

###############################################################################
# Marketplace defaults (non-money platform settings live in the `settings`
# table and are editable in the admin console — see settings() helper)
###############################################################################

MONAFIND_DISPLAY_TIMEZONE=Africa/Lusaka
# The currency is fixed to ZMW in App\Support\Money\Money; it is not an env value.

###############################################################################
# Logging
###############################################################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — MySQL 8 (service: mysql)
###############################################################################

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=monafind
DB_USERNAME=monafind
DB_PASSWORD=secret
# Only used by compose to bootstrap the container:
DB_ROOT_PASSWORD=root

###############################################################################
# Session / cache / queue — all Redis-backed (service: redis)
###############################################################################

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production MUST set this to true. Left unset the session cookie is sent over
# plain HTTP too, which makes every other session control decorative.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon dashboard is gated by the `viewHorizon` gate; in non-local
# environments only users with the platform-admin role may open it.
HORIZON_PATH=horizon
HORIZON_PREFIX=monafind_horizon:

###############################################################################
# Search — Meilisearch via Laravel Scout (service: meilisearch)
###############################################################################

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_PREFIX=monafind_
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
# Read-only key handed to the browser for instant-search widgets:
MEILISEARCH_SEARCH_KEY=

###############################################################################
# Mail — Mailpit in dev (service: mailpit, UI on http://localhost:8025)
###############################################################################

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@monafindauto.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Payments — Lenco API v2 (https://lenco-api.readme.io/v2.0)
#
# SANDBOX EVERYWHERE EXCEPT PRODUCTION. The secret key is server-side only;
# only LENCO_PUBLIC_KEY is ever exposed to the browser (inline widget).
###############################################################################

# sandbox or live. Picks the API host AND the widget host together, so the two
# can never be mismatched.
LENCO_ENVIRONMENT=sandbox

LENCO_PUBLIC_KEY=
LENCO_SECRET_KEY=

# The Lenco account payouts and refunds are debited from. Required before any
# transfer can be sent.
LENCO_ACCOUNT_ID=

# Lenco signs webhooks with HMAC-SHA512 using the "webhook hash key", which is
# documented as the SHA-256 of the API token. Leave this blank and it is
# derived; set it only if the derived value turns out not to match.
LENCO_WEBHOOK_SECRET=

# Overrides. Lenco serves BOTH environments from the same REST host and tells
# them apart by the API token — only the widget host actually differs — so
# these are here for the day that changes, not for switching environments.
# LENCO_API_URL=https://api.lenco.co/access/v2
# LENCO_WIDGET_URL=https://pay.sandbox.lenco.co/js/v1/inline.js

# Who pays Lenco's charge on a collection: merchant (default) or customer.
LENCO_FEE_BEARER=merchant

LENCO_HTTP_TIMEOUT=30

# The live sandbox test in tests/Feature/Payments/LencoSandboxTest.php is
# excluded from the suite and does nothing unless this is true.
# LENCO_SANDBOX_TESTS=false
# LENCO_SANDBOX_PAYOUT_TESTS=false

###############################################################################
# Maps — Google Maps JS API + Geocoding + Distance Matrix
#
# Keep the browser key and the server key separate so the server key can stay
# IP-restricted and the browser key HTTP-referrer-restricted.
###############################################################################

GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_REGION=ZM
GOOGLE_MAPS_LANGUAGE=en

###############################################################################
# SMS — Zamtel
###############################################################################

SMS_PROVIDER=log
ZAMTEL_SMS_BASE_URL=https://bulksms.zamtel.co.zm/api/v3
ZAMTEL_SMS_USERNAME=
ZAMTEL_SMS_PASSWORD=
ZAMTEL_SMS_API_KEY=
ZAMTEL_SMS_SENDER_ID=MonaFind

###############################################################################
# Integration drivers — swap to `fake` in tests, `live` in production
# (accepted: live | fake, plus `log` for SMS)
###############################################################################

PAYMENT_GATEWAY_DRIVER=fake
MAPS_PROVIDER_DRIVER=fake

###############################################################################
# Media library
###############################################################################

MEDIA_DISK=public
MEDIA_QUEUE_CONNECTION=redis
MEDIA_QUEUE=media

###############################################################################
# Listing media (Catalog)
#
# Photo originals stay on the private disk; buyers are served the resized,
# watermarked WebP conversions. Video transcoding needs the ffmpeg binaries —
# where they are missing the upload still succeeds and the seller's original is
# kept, so set CATALOG_VIDEO_TRANSCODE=false rather than leaving a box to
# discover it. Upload ceilings are in kilobytes.
###############################################################################

CATALOG_VIDEO_TRANSCODE=true
CATALOG_FFMPEG_BINARY=ffmpeg
CATALOG_FFPROBE_BINARY=ffprobe
CATALOG_MAX_PHOTO_KB=8192
CATALOG_MAX_VIDEO_KB=102400

###############################################################################
# Frontend (Vite) — only VITE_* reaches the browser bundle
###############################################################################

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_KEY="${GOOGLE_MAPS_BROWSER_KEY}"
VITE_LENCO_PUBLIC_KEY="${LENCO_PUBLIC_KEY}"
VITE_MEILISEARCH_HOST="${MEILISEARCH_HOST}"
VITE_MEILISEARCH_SEARCH_KEY="${MEILISEARCH_SEARCH_KEY}"

###############################################################################
# Inertia SSR — pre-renders storefront pages for search engines. The Vite
# plugin serves SSR in dev; production runs `php artisan inertia:start-ssr`
# against the bundle built by `npm run build:ssr`.
###############################################################################

INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

###############################################################################
# Browser tests (Laravel Dusk)
#
# `php artisan dusk` reads .env.dusk.local when present and starts its own
# ChromeDriver, so nothing extra is needed locally. Point DUSK_DRIVER_URL at a
# remote Selenium grid only if you run one.
###############################################################################

# DUSK_DRIVER_URL=http://selenium:4444/wd/hub

# Social sign-in (Socialite). A provider is hidden until both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
